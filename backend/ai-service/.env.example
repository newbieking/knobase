# LLM Gateway Configuration
# Copy this file to .env and fill in your values.
# Leave LLM_API_KEY empty to use local retrieval mode (no LLM).

LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_ID=gpt-4o-mini
LLM_MODEL_NAME=GPT-4o mini
LLM_TIMEOUT_SECONDS=25

# Semantic retrieval (optional)
# Point these at an OpenAI-compatible /v1/embeddings endpoint to replace the offline
# LSI semantic path with real vectors. Leave EMBEDDING_API_KEY empty to stay offline.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL_ID=

# Cascade rerank (optional): local Top-30 -> model scoring; empty values keep local scoring.
RERANK_API_KEY=
# DashScope: full text-rerank URL; other services: base URL (appends /rerank) or full /rerank(s) URL.
RERANK_BASE_URL=
RERANK_MODEL_ID=

# Local SQLite cache for segmentation and embedding vectors.
# Defaults to backend/ai-service/.index/retrieval.db next to app.py.
RAG_INDEX_PATH=
